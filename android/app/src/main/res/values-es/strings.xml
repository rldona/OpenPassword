    <string name="kit_subtitle">Kit de emergencia</string>
    <string name="kit_created_on">Creado el %1$s</string>
    <string name="kit_intro">Con este papel y tu contraseña maestra puedes recuperar tus datos en otro teléfono a partir de una copia de seguridad (.opvault). Sin los dos, nadie puede descifrarla: tampoco nosotros.</string>
    <string name="kit_secret_key_label">CLAVE SECRETA</string>
    <string name="kit_ambiguity_note">Las letras O, I y L no se usan: si dudas, es un cero o un uno.</string>
    <string name="kit_master_password_label">CONTRASEÑA MAESTRA (OPCIONAL, A MANO)</string>
    <string name="kit_master_password_warning">Escríbela solo si vas a guardar este papel en un lugar realmente seguro. Quien tenga el papel con la contraseña y una copia de tu caja fuerte podrá abrirla.</string>
    <string name="kit_restore_label">CÓMO RECUPERAR TUS DATOS</string>
    <string name="kit_restore_step_1">Instala OpenPassword en el teléfono nuevo y elige «%1$s».</string>
    <string name="kit_restore_step_2">Elige tu fichero .opvault (de tu ordenador, una tarjeta SD o tu nube).</string>
    <string name="kit_restore_step_3">Escribe la clave secreta de este papel y tu contraseña maestra.</string>
    <string name="kit_offline_tool">Sin la app también puedes descifrar la copia con la herramienta de código abierto «opvault decrypt» (github.com/rldona/OpenPassword).</string>
    <string name="kit_keep_safe_label">GUÁRDALO BIEN</string>
    <string name="kit_keep_safe_1">Imprímelo y guárdalo con tus documentos importantes, o dáselo a alguien de confianza.</string>
    <string name="kit_keep_safe_2">Borra el PDF del teléfono después de imprimirlo. No lo subas a la nube ni le hagas fotos.</string>
    <string name="kit_keep_safe_3">Si pierdes este papel y tu contraseña maestra, tus copias no se podrán abrir.</string>
    <string name="kit_footer">OpenPassword es software libre (GPL-3.0-or-later).</string>
    <string name="onboarding_restore">Restaurar una copia de seguridad</string>

