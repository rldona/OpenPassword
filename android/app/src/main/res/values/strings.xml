    <string name="kit_subtitle">Emergency kit</string>
    <string name="kit_created_on">Created on %1$s</string>
    <string name="kit_intro">With this sheet and your master password you can recover your data on another phone from a backup (.opvault). Without both, nobody can decrypt it: not even us.</string>
    <string name="kit_secret_key_label">SECRET KEY</string>
    <string name="kit_ambiguity_note">The letters O, I and L are not used: if in doubt, it is a zero or a one.</string>
    <string name="kit_master_password_label">MASTER PASSWORD (OPTIONAL, BY HAND)</string>
    <string name="kit_master_password_warning">Write it down only if you are going to keep this sheet somewhere truly safe. Whoever has the sheet with the password and a backup of your vault will be able to open it.</string>
    <string name="kit_restore_label">HOW TO RECOVER YOUR DATA</string>
    <string name="kit_restore_step_1">Install OpenPassword on the new phone and choose «%1$s».</string>
    <string name="kit_restore_step_2">Pick your .opvault file (from your computer, an SD card or your cloud).</string>
    <string name="kit_restore_step_3">Type the secret key from this sheet and your master password.</string>
    <string name="kit_offline_tool">Without the app you can also decrypt the backup with the open-source tool «opvault decrypt» (github.com/rldona/OpenPassword).</string>
    <string name="kit_keep_safe_label">KEEP IT SAFE</string>
    <string name="kit_keep_safe_1">Print it and keep it with your important documents, or give it to someone you trust.</string>
    <string name="kit_keep_safe_2">Delete the PDF from the phone after printing it. Do not upload it to the cloud or take photos of it.</string>
    <string name="kit_keep_safe_3">If you lose this sheet and your master password, your backups cannot be opened.</string>
    <string name="kit_footer">OpenPassword is free software (GPL-3.0-or-later).</string>
    <string name="onboarding_restore">Restore a backup</string>

