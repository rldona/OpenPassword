<?xml version="1.0" encoding="utf-8"?>
<!-- OpenPassword never reaches the network: no INTERNET permission. Enforced by verify*Manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only to show the system fingerprint/face prompt for biometric unlock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Only to scan TOTP setup QR codes; requested when the user taps "Escanear QR". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 12+: hides other apps' overlay windows while OpenPassword is on screen (anti-tapjacking). Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- CameraX pulls media3 (for video, unused here), which declares this; the app has no network at all. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Package visibility (Android 11+) for the local root-manager check. Names only; no QUERY_ALL_PACKAGES. Keep in sync with RootDetector.ROOT_PACKAGES. -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.kingroot.kinguser" />
    </queries>

    <application
        android:name=".OpenPasswordApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.OpenPassword"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened from an autofill suggestion to unlock and pick a login. -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Opened after "save to OpenPassword" to confirm a login typed into another app. -->
        <activity
            android:name=".autofill.SaveLoginActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Only Android itself can bind to it (BIND_AUTOFILL_SERVICE is a system permission). -->
        <service
            android:name=".autofill.OpAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
